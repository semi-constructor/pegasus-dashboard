API_URL=http://localhost:2000
BOT_API_TOKEN=

# Database Configuration
DATABASE_URL=""

# Redis Configuration (Optional - falls back to in-memory cache if down/unreachable)
REDIS_URL=redis://localhost:6379

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord Bot Token (for checking bot presence in guilds)
DISCORD_BOT_TOKEN=

# Public Discord Client ID (for client-side usage)
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Application Settings
NODE_ENV=production

# Optional: Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google Analytics & Tracking
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-site-verification-id"

# DEVELOPERS
# - Array of Discord User IDs, when logged in, all database information can be edited.
ADMIN=[""]

# Imprint Legal
IMP_NAME="Jensen Huang"
# - Legal full name
IMP_ZIP="12345"
# - ZIP Code City
IMP_CTY="Berlin"
# - City Name
IMP_STREET="Musterstraße"
# - Street Name
IMP_STRNM="1"
# - Street Number
IMP_COUNTRY="United Kingdom"
# - Country Name
IMP_EMAIL="hello@world.io"
# - Email Address
IMP_USTID=false
# - VAT ID (if applicable)
IMP_HRB=false
# - Commercial Register Number (if applicable)